# PostgreSQL Connection String (e.g. Neon PostgreSQL, Supabase, or Local PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres:password123@localhost:5432/simpay_db?sslmode=disable"

# Application Environment
NODE_ENV="development"
PORT=3000
