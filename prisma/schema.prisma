generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int                  @id @default(autoincrement())
  name               String
  email              String               @unique
  password           String
  role               String
  sipNumber          String?
  medicalRecords     MedicalRecord[]
  processedPayments  Payment[]
  issuedCertificates MedicalCertificate[] @relation("IssuedCertificates")
  doctorCertificates MedicalCertificate[] @relation("DoctorCertificates")
  stockMovements     StockMovement[]
  createdPurchaseOrders   PurchaseOrder[]   @relation("CreatedPurchaseOrders")
  createdPurchaseInvoices PurchaseInvoice[] @relation("CreatedPurchaseInvoices")
}

model Patient {
  id                  Int                  @id @default(autoincrement())
  name                String
  dateOfBirth         DateTime
  gender              String
  occupation          String?
  address             String?
  phone               String?
  medicalRecords      MedicalRecord[]
  queues              Queue[]
  prescriptions       Prescription[]
  billings            Billing[]
  medicalCertificates MedicalCertificate[]
}

model MedicalRecord {
  id                 Int            @id @default(autoincrement())
  patientId          Int
  doctorId           Int?
  queueId            Int?           @unique
  examinationDate    DateTime
  complaint          String?
  diagnosis          String?
  treatment          String?
  notes              String?
  icd10Code          String?
  secondaryDiagnosis String?
  bloodPressure      String?
  temperature        String?
  heartRate          String?
  respiratoryRate    String?
  allergy            String?
  nextControlDate    DateTime?
  status             String?        @default("ANTRE")

  patient       Patient            @relation(fields: [patientId], references: [id])
  doctor        User?              @relation(fields: [doctorId], references: [id])
  queue         Queue?             @relation(fields: [queueId], references: [id])
  prescriptions Prescription[]
  procedures    PatientProcedure[]
  billing       Billing?
}

model Procedure {
  id          Int                @id @default(autoincrement())
  code        String?
  name        String
  tariff      Float              @default(0)
  category    String?            @default("Tindakan Umum")
  description String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  patientProcedures PatientProcedure[]
}

model PatientProcedure {
  id              Int           @id @default(autoincrement())
  medicalRecordId Int
  procedureId     Int?
  procedureName   String
  tariff          Float         @default(0)
  quantity        Int           @default(1)
  performer       String?       @default("DOKTER")
  notes           String?
  createdAt       DateTime      @default(now())

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  procedure     Procedure?    @relation(fields: [procedureId], references: [id], onDelete: SetNull)
}

model Queue {
  id          Int      @id @default(autoincrement())
  patientId   Int
  queueNumber Int
  status      String
  polyclinic  String?
  date        DateTime @default(now())

  patient       Patient        @relation(fields: [patientId], references: [id])
  medicalRecord MedicalRecord?
  billing       Billing?
}

model Prescription {
  id              Int     @id @default(autoincrement())
  patientId       Int
  medicalRecordId Int
  medicineId      Int?
  medicineName    String
  dosage          String
  instructions    String?
  quantity        Int?    @default(1)
  unitPrice       Float?  @default(0)
  totalPrice      Float?  @default(0)
  status          String? @default("ANTRE")

  patient       Patient        @relation(fields: [patientId], references: [id])
  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  medicine      Medicine?      @relation(fields: [medicineId], references: [id])
}

model Medicine {
  id            Int             @id @default(autoincrement())
  name          String          @unique
  code          String?         @unique
  unit          String          @default("Tablet")
  category      String?         @default("Obat Bebas")
  brandType     String?         @default("GENERIK") // "GENERIK" | "PATEN_BERMEREK"
  brandName     String?         // Nama dagang paten jika ada
  genericName   String?         // Nama zat aktif generik
  unitPrice     Float           @default(0)
  purchasePrice Float?          @default(0)
  minStock      Int             @default(10)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  batches              MedicineBatch[]
  prescriptions        Prescription[]
  stockMovements       StockMovement[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
}

model MedicineBatch {
  id              Int      @id @default(autoincrement())
  medicineId      Int
  batchNumber     String
  stockQuantity   Int      @default(0)
  initialQuantity Int      @default(0)
  expiryDate      DateTime
  receivedDate    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  medicine             Medicine              @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  stockMovements       StockMovement[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
}

model StockMovement {
  id            Int      @id @default(autoincrement())
  medicineId    Int
  batchId       Int?
  type          String   // "IN" | "OUT" | "DISPENSE" | "ADJUSTMENT" | "EXPIRED_DISPOSAL"
  quantity      Int      // e.g. +100 or -10
  previousStock Int      @default(0)
  currentStock  Int      @default(0)
  notes         String?
  referenceNo   String?
  createdById   Int?
  createdByName String   @default("Sistem")
  createdAt     DateTime @default(now())

  medicine  Medicine       @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batch     MedicineBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdBy User?          @relation(fields: [createdById], references: [id])
}

model Billing {
  id              Int            @id @default(autoincrement())
  patientId       Int
  queueId         Int?           @unique
  medicalRecordId Int?           @unique
  registrationFee Float          @default(0)
  consultationFee Float          @default(50000)
  medicineFee     Float          @default(0)
  otherFee        Float          @default(0)
  totalAmount     Float          @default(50000)
  status          String         @default("BELUM_LUNAS") // BELUM_LUNAS | LUNAS | CANCELLED
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  patient       Patient        @relation(fields: [patientId], references: [id])
  queue         Queue?         @relation(fields: [queueId], references: [id])
  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  payment       Payment?
}

model Payment {
  id            Int      @id @default(autoincrement())
  billingId     Int      @unique
  processedById Int?
  paymentNumber String   @unique // e.g. INV-20260909-001
  paymentMethod String // TUNAI | QRIS | TRANSFER
  totalAmount   Float
  amountPaid    Float
  changeAmount  Float    @default(0)
  paymentDate   DateTime @default(now())

  billing     Billing @relation(fields: [billingId], references: [id])
  processedBy User?   @relation(fields: [processedById], references: [id])
}

model MedicalCertificate {
  id            Int      @id @default(autoincrement())
  certificateNo String   @unique
  type          String   // "SAKIT" | "SEHAT"
  patientId     Int
  doctorId      Int?
  doctorName    String?
  doctorSip     String?
  issuedById    Int?
  issuedByName  String
  date          DateTime @default(now())

  // Fields for Surat Sakit
  startDate     DateTime?
  endDate       DateTime?
  durationDays  Int?
  diagnosis     String?
  occupation    String?

  // Fields for Surat Sehat
  heightCm      Int?
  weightKg      Int?
  bloodPressure String?
  bloodType     String?
  colorBlind    String? // "Tidak" | "Ya" | "Parsial"
  purpose       String? // Keperluan

  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient       Patient  @relation(fields: [patientId], references: [id])
  issuedBy      User?    @relation("IssuedCertificates", fields: [issuedById], references: [id])
  doctor        User?    @relation("DoctorCertificates", fields: [doctorId], references: [id])
}

model Supplier {
  id            Int               @id @default(autoincrement())
  code          String            @unique // e.g. "PBF-AAM"
  name          String            // e.g. "PT Anugrah Argon Medica (AAM)"
  address       String?
  phone         String?
  email         String?
  picName       String?           // Kontak person PBF
  licenseNumber String?           // No. Izin PBF
  isPkp         Boolean           @default(false)
  npwp          String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
}

model PurchaseOrder {
  id             Int                 @id @default(autoincrement())
  orderNumber    String              @unique // e.g. "PO-202610-0001"
  supplierId     Int
  orderDate      DateTime            @default(now())
  expectedDate   DateTime?
  status         String              @default("MENUNGGU") // MENUNGGU | DISETUJUI | DIKIRIM | SELESAI | DIBATALKAN
  notes          String?
  createdById    Int?
  createdByName  String              @default("Staf Farmasi")
  totalEstimated Float               @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  createdBy        User?               @relation("CreatedPurchaseOrders", fields: [createdById], references: [id])
  items            PurchaseOrderItem[]
  purchaseInvoices PurchaseInvoice[]
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  medicineId      Int
  medicineName    String
  unit            String        @default("Tablet")
  quantity        Int           @default(1)
  estimatedPrice  Float         @default(0)
  subtotal        Float         @default(0)
  notes           String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  medicine      Medicine      @relation(fields: [medicineId], references: [id])
}

model PurchaseInvoice {
  id                     Int                   @id @default(autoincrement())
  invoiceNumber          String                @unique // No faktur sistem (identik): "FAK-202610-0001"
  supplierInvoiceNumber  String                // No faktur fisik dari supplier PBF
  purchaseOrderId        Int?
  supplierId             Int
  transactionDate        DateTime              @default(now())
  facilityLocation       String                @default("Klinik Pratama SIMPAY") // Lokasi Faskes
  paymentMethod          String                @default("KREDIT") // TUNAI | TRANSFER | KREDIT
  creditTerm             String?               // D7 | D21 | D30 | null
  dueDate                DateTime?             // Jatuh tempo dihitung otomatis
  status                 String                @default("PROSES") // PROSES | TUNDA | SELESAI
  paymentStatus          String                @default("TAGIHAN") // TAGIHAN | LUNAS
  taxInvoiceNumber       String?               // No faktur pajak jika PKP
  notes                  String?

  // Kalkulasi Footer Faktur
  totalQty               Int                   @default(0)
  totalQtyBonus          Int                   @default(0)
  subtotalBeforeDiscount Float                 @default(0)
  itemDiscountAmount     Float                 @default(0)
  additionalDiscount     Float                 @default(0)
  dppAmount              Float                 @default(0) // Harga sebelum PPN
  taxRate                Float                 @default(11) // PPN %
  taxAmount              Float                 @default(0) // Nilai PPN
  totalAmount            Float                 @default(0) // Total nilai faktur (wajib klop fisik)

  createdById            Int?
  createdByName          String                @default("Staf Farmasi")
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdBy     User?                 @relation("CreatedPurchaseInvoices", fields: [createdById], references: [id])
  items         PurchaseInvoiceItem[]
}

model PurchaseInvoiceItem {
  id                Int             @id @default(autoincrement())
  purchaseInvoiceId Int
  medicineId        Int
  medicineName      String
  batchNumber       String
  expiryDate        DateTime
  quantity          Int             @default(1)
  bonusQuantity     Int             @default(0)
  unit              String          @default("Tablet")
  hnaPrice          Float           @default(0) // HNA per item
  discountPercent   Float           @default(0) // Diskon item (%)
  isTaxable         Boolean         @default(true) // Pajak / Non-pajak
  hnaWithTax        Float           @default(0) // HNA + PPN
  discountWithTax   Float           @default(0) // Diskon + PPN
  subtotal          Float           @default(0) // Subtotal sebelum diskon
  netPrice          Float           @default(0) // Harga beli NET per satuan
  batchId           Int?            // Relasi batch yang terbuat

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  medicine        Medicine        @relation(fields: [medicineId], references: [id])
  batch           MedicineBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
}